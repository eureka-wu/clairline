# =============================================================================
# 长龙航空畅飞卡智能巡检与监控平台 · 环境变量配置模板
# 复制本文件为 .env 即可生效：cp .env.example .env
# =============================================================================

# 数据库连接配置 (双模态自适应：留空默认使用本地高性能 SQLite)
# 如需连接外部 MySQL 实例，请取消注释并填写您的连接串 (通用占位符示例)：
# DATABASE_URL=mysql+pymysql://db_user:your_password@mysql_host:3306/loongair?charset=utf8mb4

# 服务绑定主机与端口 (Docker 内部默认 3000)
CLAIRLINE_HOST=0.0.0.0
CLAIRLINE_PORT=3000

# 时区设置 (中国标准时间)
TZ=Asia/Shanghai
